    "__init__.py",
    # Target of Chromite symlinks
    "scripts/wrapper3.py",
    # Needed by wrapper3.py to identify the Chromite root dir
    "PRESUBMIT.cfg",
    # Needed for any packages that do remote execution via reclient (not Bazel)
    "sdk/reclient_cfgs/**",
]

pkg_files(
    name = "__cros_generate_coverage_artifacts_files__",
    srcs = glob(
        # This list covers the invocation of
        # chromite/scripts/cros_generate_coverage_artifacts from
        # cros_post_src_install_coverage_logs() in profiles/base/profile.bashrc.
        #
        # We manually maintain this list here (rather than dynamically computing
        # it) to prevent unknowing inclusion of additional Chromite dependencies
        # that might expand the set of Chromite modules that can cache-bust all
        # packages in a Bazel build.
        [
            # Placeholder for __cros_generate_coverage_artifacts_files__
        ] + _chromite_common_files,
    ),
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "/mnt/host/source/chromite",
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//visibility:private"],
)

