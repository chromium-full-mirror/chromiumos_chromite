# Clean up rust packages which do not use the new registry lock (b/300538388).
#
# virtual/rust-binaries-1-r7 is the oldest version of rust-binaries that uses
# the new lock, so everything before then must go.

do_clean() {
  local suffix="$1"
  local depends
  depends=( $("equery${suffix}" d "<=virtual/rust-binaries-1-r6") )
  [[ "${#depends[@]}" -eq 0 ]] && return

  local emerge_command=()
  if [[ -z "${suffix}" ]]; then
    emerge_command=( sudo emerge )
  else
    emerge_command=( "emerge${suffix}" )
  fi
  "${emerge_command[@]}" --rage-clean "${depends[@]}"
}

do_clean
for board_root in /build/*; do
  board_name=${board_root##*/}
  if [[ -d "${board_root}/var/db/pkg" ]]; then
    do_clean "-${board_name}"
  fi
done
