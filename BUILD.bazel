# Chromite has some recursive symlinks which we need to exclude

package_group(
    name = "all_packages",
    packages = [
        "//...",
    ],
)

_chromite_common_files = [
    "__init__.py",
    # Target of Chromite symlinks
    "scripts/wrapper3.py",
    # Needed by wrapper3.py to identify the Chromite root dir
    "PRESUBMIT.cfg",
    # Needed for any packages that do remote execution via reclient (not Bazel)
    "sdk/reclient_cfgs/**",
]

